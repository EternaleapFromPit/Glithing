public class DbContextOptions {
    public string ConnectionString;

    public DbContextOptions() {
        this.ConnectionString = "";
    }
}

public class SqlProvider {
    public string Name;
    public string ConnectionString;

    public SqlProvider(string name, string connectionString) {
        this.Name = name;
        this.ConnectionString = connectionString;
    }

    public string BuildSelectAll(string table) {
        string prefix = "select * from ";
        return prefix + table;
    }
}

public struct DbSet<T> {
    public List<T> Items;

    public DbQuery<T> AsQueryable() {
        var items = new List<T>();
        if (this.Items != null) {
            int i = 0;
            while (i < this.Items.Count) {
                items.Add(this.Items[i]);
                i = i + 1;
            }
        }
        return new DbQuery<T> { Rows = items };
    }

    public DbQuery<T> AsNoTracking() {
        var items = new List<T>();
        if (this.Items != null) {
            int i = 0;
            while (i < this.Items.Count) {
                items.Add(this.Items[i]);
                i = i + 1;
            }
        }
        return new DbQuery<T> { Rows = items };
    }

    public DbQuery<T> Where(Func<T, bool> predicate) {
        var items = new List<T>();
        if (this.Items != null) {
            int i = 0;
            while (i < this.Items.Count) {
                items.Add(this.Items[i]);
                i = i + 1;
            }
        }
        return new DbQuery<T> { Rows = items, Predicate = predicate };
    }

    public int Count {
        get {
            return this.AsQueryable().Count;
        }
    }

    public void Add(T entity) {
        if (this.Items == null) {
            this.Items = new List<T>();
        }
        var items = this.Items;
        items.Add(entity);
    }

    public void Clear() {
        if (this.Items == null) {
            this.Items = new List<T>();
        }
        this.Items.Clear();
    }

    public Task AddAsync(T entity, CancellationToken cancellationToken) {
        this.Add(entity);
        return Task.CompletedTask;
    }

    public Task AddAsync(T entity) {
        this.Add(entity);
        return Task.CompletedTask;
    }

    public Task AddRangeAsync(IEnumerable<T> entities, CancellationToken cancellationToken) {
        foreach (var entity in entities) {
            this.Add(entity);
        }
        return Task.CompletedTask;
    }

    public Task AddRangeAsync(List<T> entities, CancellationToken cancellationToken) {
        int i = 0;
        while (i < entities.Count) {
            this.Add(entities[i]);
            i = i + 1;
        }
        return Task.CompletedTask;
    }

    public Task<bool> AnyAsync(CancellationToken cancellationToken) {
        return this.AsQueryable().AnyAsync(cancellationToken);
    }

    public Task<bool> AnyAsync(Func<T, bool> predicate, CancellationToken cancellationToken) {
        return this.Where(predicate).AnyAsync(cancellationToken);
    }

    public Task<T> FirstAsync(CancellationToken cancellationToken) {
        return this.AsQueryable().FirstAsync(cancellationToken);
    }

    public Task<T> FirstAsync(Func<T, bool> predicate, CancellationToken cancellationToken) {
        return this.Where(predicate).FirstAsync(cancellationToken);
    }

    public Task<T> FirstOrDefaultAsync(CancellationToken cancellationToken) {
        return this.AsQueryable().FirstOrDefaultAsync(cancellationToken);
    }

    public Task<T> FirstOrDefaultAsync(Func<T, bool> predicate, CancellationToken cancellationToken) {
        return this.Where(predicate).FirstOrDefaultAsync(cancellationToken);
    }

    public Task<T> SingleOrDefaultAsync(CancellationToken cancellationToken) {
        return this.AsQueryable().SingleOrDefaultAsync(cancellationToken);
    }

    public Task<T> SingleOrDefaultAsync(Func<T, bool> predicate, CancellationToken cancellationToken) {
        return this.Where(predicate).SingleOrDefaultAsync(cancellationToken);
    }

    public Task<List<T>> ToListAsync(CancellationToken cancellationToken) {
        return this.AsQueryable().ToListAsync(cancellationToken);
    }

    public Task<T> FindAsync(object key) {
        return new Task<T> { Result = default(T) };
    }

    public List<T> Snapshot() {
        var copy = new List<T>();
        if (this.Items == null) {
            return copy;
        }
        int i = 0;
        while (i < this.Items.Count) {
            copy.Add(this.Items[i]);
            i = i + 1;
        }
        return copy;
    }
}

public struct DbQuery<T> {
    public List<T> Rows;
    public Func<T, bool> Predicate;

    public List<T> RowsSnapshot() {
        return this.Rows;
    }

    public bool Matches(T item) {
        if (this.Predicate != null && !this.Predicate(item)) {
            return false;
        }
        return true;
    }

    public DbQuery<T> AsQueryable() {
        return new DbQuery<T> { Rows = this.Rows, Predicate = this.Predicate };
    }

    public DbQuery<T> AsNoTracking() {
        return new DbQuery<T> { Rows = this.Rows, Predicate = this.Predicate };
    }

    public DbQuery<T> Include(object navigation) {
        return new DbQuery<T> { Rows = this.Rows, Predicate = this.Predicate };
    }

    public DbQuery<T> ThenInclude(object navigation) {
        return new DbQuery<T> { Rows = this.Rows, Predicate = this.Predicate };
    }

    public DbQuery<T> Where(Func<T, bool> predicate) {
        return new DbQuery<T> {
            Rows = this.Rows,
            Predicate = predicate,
        };
    }

    public int Count {
        get {
            int count = 0;
            int i = 0;
            var items = RowsSnapshot();
            while (i < items.Count) {
                if (this.Matches(items[i])) {
                    count = count + 1;
                }
                i = i + 1;
            }
            return count;
        }
    }

    public Task<bool> AnyAsync(CancellationToken cancellationToken) {
        int i = 0;
        var items = RowsSnapshot();
        while (i < items.Count) {
            if (this.Matches(items[i])) {
                return new Task<bool> { Result = true };
            }
            i = i + 1;
        }
        return new Task<bool> { Result = false };
    }

    public Task<T> FirstAsync(CancellationToken cancellationToken) {
        int i = 0;
        var items = RowsSnapshot();
        while (i < items.Count) {
            var item = items[i];
            if (this.Matches(item)) {
                return new Task<T> { Result = item };
            }
            i = i + 1;
        }
        return new Task<T> { Result = default(T) };
    }

    public Task<T> FirstAsync(Func<T, bool> predicate, CancellationToken cancellationToken) {
        return this.Where(predicate).FirstAsync(cancellationToken);
    }

    public Task<T> FirstOrDefaultAsync(CancellationToken cancellationToken) {
        return this.FirstAsync(cancellationToken);
    }

    public Task<T> FirstOrDefaultAsync(Func<T, bool> predicate, CancellationToken cancellationToken) {
        return this.Where(predicate).FirstOrDefaultAsync(cancellationToken);
    }

    public Task<T> SingleOrDefaultAsync(CancellationToken cancellationToken) {
        int i = 0;
        T found = default(T);
        bool has = false;
        var items = RowsSnapshot();
        while (i < items.Count) {
            var item = items[i];
            if (this.Matches(item)) {
                if (has) {
                    return new Task<T> { Result = default(T) };
                }
                found = item;
                has = true;
            }
            i = i + 1;
        }
        return new Task<T> { Result = found };
    }

    public Task<T> SingleOrDefaultAsync(Func<T, bool> predicate, CancellationToken cancellationToken) {
        return this.Where(predicate).SingleOrDefaultAsync(cancellationToken);
    }

    public Task<List<T>> ToListAsync(CancellationToken cancellationToken) {
        var list = new List<T>();
        int i = 0;
        var items = RowsSnapshot();
        while (i < items.Count) {
            var item = items[i];
            if (this.Matches(item)) {
                list.Add(item);
            }
            i = i + 1;
        }
        return new Task<List<T>> { Result = list };
    }
}

