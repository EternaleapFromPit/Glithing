package System.Data.SqlClient;

using System;
using System.Net.Sockets;

public class SqlException : Exception {
    public int Number { get; set; }

    public SqlException(string message, int number) : base(message) {
        Number = number;
    }
}

public class SqlConnection {
    string _connectionString;
    string _server;
    int _port;
    string _database;
    string _userId;
    string _password;
    bool _encrypt;
    bool _trustServerCertificate;
    TcpClient _client;
    NetworkStream _stream;

    public SqlConnection(string connectionString) {
        _connectionString = connectionString;
        _server = "127.0.0.1";
        _port = 1433;
        _database = "";
        _userId = "";
        _password = "";
        _encrypt = false;
        _trustServerCertificate = true;
        ParseConnectionString(connectionString);
    }

    public string ConnectionString {
        get { return _connectionString; }
        set {
            _connectionString = value;
            ParseConnectionString(value);
        }
    }

    public bool IsOpen {
        get { return _client != null && _client.Connected; }
    }

    public string Database {
        get { return _database; }
    }

    public string DataSource {
        get { return _server; }
    }

    public void Open() {
        if (this.IsOpen) {
            return;
        }
        _client = new TcpClient(_server, _port);
        _stream = _client.GetStream();
        if (_encrypt && !_trustServerCertificate) {
            throw new SqlException("Encrypted SQL Server connections are not yet implemented in the Gl transport layer.", 0);
        }
    }

    public void Close() {
        if (_stream != null) {
            _stream.Close();
            _stream = null;
        }
        if (_client != null) {
            _client.Close();
            _client = null;
        }
    }

    public SqlCommand CreateCommand() {
        return new SqlCommand(this);
    }

    internal NetworkStream Stream {
        get { return _stream; }
    }

    internal void EnsureOpen() {
        if (!this.IsOpen) {
            throw new SqlException("The SQL connection is not open.", 0);
        }
    }

    void ParseConnectionString(string connectionString) {
        if (connectionString == null || connectionString.Length == 0) {
            return;
        }
        string[] parts = connectionString.Split(";");
        int i = 0;
        while (i < parts.Length) {
            string part = parts[i].Trim();
            if (part.Length != 0) {
                string[] keyValue = part.Split("=");
                if (keyValue.Length >= 2) {
                    string key = keyValue[0].Trim().ToLowerInvariant();
                    string value = keyValue[1].Trim();
                    if (key == "server" || key == "data source") {
                        ParseServerAndPort(value);
                    } else if (key == "initial catalog" || key == "database") {
                        _database = value;
                    } else if (key == "user id" || key == "uid") {
                        _userId = value;
                    } else if (key == "password" || key == "pwd") {
                        _password = value;
                    } else if (key == "encrypt") {
                        _encrypt = value.ToLowerInvariant() == "true" || value == "yes" || value == "1";
                    } else if (key == "trustservercertificate") {
                        _trustServerCertificate = value.ToLowerInvariant() == "true" || value == "yes" || value == "1";
                    }
                }
            }
            i = i + 1;
        }
    }

    void ParseServerAndPort(string value) {
        if (value == null || value.Length == 0) {
            return;
        }
        string[] parts = value.Split(",");
        if (parts.Length >= 1 && parts[0].Trim().Length != 0) {
            _server = parts[0].Trim();
        }
        if (parts.Length >= 2) {
            int parsed = 0;
            if (int.TryParse(parts[1].Trim(), out parsed)) {
                _port = parsed;
            }
        }
    }
}

public class SqlCommand {
    SqlConnection _connection;
    string _commandText;

    public SqlCommand(SqlConnection connection) {
        _connection = connection;
    }

    public string CommandText {
        get { return _commandText; }
        set { _commandText = value; }
    }

    public SqlDataReader ExecuteReader() {
        _connection.EnsureOpen();
        throw new SqlException("TDS result streaming is not implemented yet.", 0);
    }

    public int ExecuteNonQuery() {
        _connection.EnsureOpen();
        throw new SqlException("TDS command execution is not implemented yet.", 0);
    }

    public object ExecuteScalar() {
        _connection.EnsureOpen();
        throw new SqlException("TDS scalar execution is not implemented yet.", 0);
    }
}

public class SqlDataReader {
    public bool Read() {
        return false;
    }

    public string GetString(int ordinal) {
        throw new SqlException("SqlDataReader is not backed by a TDS rowset yet.", 0);
    }

    public int GetInt32(int ordinal) {
        throw new SqlException("SqlDataReader is not backed by a TDS rowset yet.", 0);
    }

    public bool IsDBNull(int ordinal) {
        return true;
    }

    public void Close() {
    }
}
